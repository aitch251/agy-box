#!/usr/bin/env zsh
# ==============================================================================
# agy-box - Sandboxed Antigravity Launcher, Skills & VSCodium Setup
# ==============================================================================

set -euo pipefail

SOURCE="${0:A}"
BOX_DIR="${SOURCE:h}"
PROFILE_JSON="$BOX_DIR/profiles/sandbox-strict.json"
WP_PROMPT_TPL="$BOX_DIR/prompts/wp-creator.md"
SKILLS_SRC_DIR="$BOX_DIR/skills"
CODIUM_SRC_DIR="$BOX_DIR/codium"

AGY_SETTINGS="${AGY_SETTINGS:-$HOME/.gemini/antigravity-cli/settings.json}"
LOCAL_GIT_SETTINGS="${LOCAL_GIT_SETTINGS:-$HOME/git/local/agy/settings.json}"
GLOBAL_SKILLS_DIR="${GLOBAL_SKILLS_DIR:-$HOME/.gemini/config/skills}"
GLOBAL_SKILLS_JSON="${GLOBAL_SKILLS_JSON:-$HOME/.gemini/config/skills.json}"
CODIUM_USER_DIR="${CODIUM_USER_DIR:-$HOME/Library/Application Support/VSCodium/User}"

DEFAULT_WP_DIR="${WP_REPO_DIR:-$HOME/git/wordpress}"
DEFAULT_SITE="${WP_DEFAULT_SITE:-example.com}"
DEFAULT_PORT="${WP_DEFAULT_PORT:-8080}"

# Render profile placeholders ({{HOME}}, {{ROOT}}) into absolute paths.
# The sandbox rejects globs and relative paths in deny rules.
# Usage: render_profile <root> [extra-wp-config-path...] -> prints temp file path
render_profile() {
	local root="$1"; shift
	local out
	out="$(mktemp -t agy-box-profile).json"
	python3 - "$PROFILE_JSON" "$out" "$HOME" "$root" "$@" <<'PY'
import json, sys
src, dst, home, root, *extra = sys.argv[1:]
d = json.load(open(src, encoding="utf-8"))
deny = d["permissions"]["deny"]
for p in extra:
    deny += [f"read_file({p})", f"write_file({p})"]
d["permissions"]["deny"] = [e.replace("{{HOME}}", home).replace("{{ROOT}}", root) for e in deny]
json.dump(d, open(dst, "w", encoding="utf-8"), indent=2)
PY
	print -r -- "$out"
}

info() { printf "[agy-box] %s\n" "$*"; }
err()  { printf "[agy-box] ERROR: %s\n" "$*" >&2; }

usage() {
	cat <<EOF
agy-box — Sandboxed Antigravity CLI launcher, skill bundle & VSCodium bootstrapper

USAGE:
  agy-box [path] [agy-args...]  Run sandboxed agy (--sandbox --mode accept-edits) in current/target repo
  agy-box wp <site> [port]      Run WordPress preview + sandboxed agy (default port: ${DEFAULT_PORT})
  agy-box install [--codium]    Install agy-box, security rules, and bundled skills (+ VSCodium if --codium)
  agy-box codium                Install/configure barebones VSCodium for agy-box
  agy-box status                Print active sandbox, skill & VSCodium status
  agy-box help                  Print usage

EXAMPLES:
  agy-box install --codium      Full one-command setup (CLI + rules + skills + VSCodium)
  cd ~/git/action-data && agy-box
  agy-box ~/git/hack-server
  agy-box wp example.com
EOF
}

require_agy() {
	if ! command -v agy >/dev/null 2>&1; then
		err "'agy' not found in PATH."
		exit 1
	fi
}

install_skills() {
	mkdir -p "$HOME/.gemini/config"

	# Create ~/.gemini/config/skills.json if not present
	if [[ ! -e "$GLOBAL_SKILLS_JSON" ]]; then
		printf '{\n  "skills": [\n    "skills"\n  ]\n}\n' > "$GLOBAL_SKILLS_JSON"
		info "Created: $GLOBAL_SKILLS_JSON"
	fi

	# If ~/.gemini/config/skills is already a symlink (e.g. to local/agy/skills), keep it
	if [[ -L "$GLOBAL_SKILLS_DIR" ]]; then
		info "Skills dir already linked: $GLOBAL_SKILLS_DIR -> $(readlink "$GLOBAL_SKILLS_DIR")"
	else
		mkdir -p "$GLOBAL_SKILLS_DIR"
		for skill_path in "$SKILLS_SRC_DIR"/*(/N); do
			local skill_name="${skill_path:t}"
			local dest="$GLOBAL_SKILLS_DIR/$skill_name"
			if [[ ! -e "$dest" ]]; then
				ln -sf "$skill_path" "$dest"
				info "Installed skill: /$skill_name -> $skill_path"
			fi
		done
	fi
}

cmd_codium() {
	if ! command -v codium >/dev/null 2>&1 && [[ ! -d "/Applications/VSCodium.app" ]]; then
		if command -v brew >/dev/null 2>&1; then
			info "Installing VSCodium via Homebrew..."
			brew install --cask vscodium
		else
			err "VSCodium not installed and Homebrew ('brew') not found."
			err "Install VSCodium from https://vscodium.com or install Homebrew first."
			exit 1
		fi
	else
		info "VSCodium binary detected."
	fi

	mkdir -p "$CODIUM_USER_DIR"

	# Merge codium/settings.json into User/settings.json without clobbering existing keys
	python3 - "$CODIUM_SRC_DIR/settings.json" "$CODIUM_USER_DIR/settings.json" <<'PY'
import json, os, re, sys

src_path, dst_path = sys.argv[1], sys.argv[2]
with open(src_path, encoding="utf-8") as f:
    src = json.load(f)

dst = {}
if os.path.exists(dst_path):
    with open(dst_path, encoding="utf-8") as f:
        raw = f.read()
    # Strip single-line // comments if present in user's settings.json
    cleaned = re.sub(r"^\s*//.*$", "", raw, flags=re.MULTILINE)
    try:
        dst = json.loads(cleaned)
    except Exception:
        dst = {}

for k, v in src.items():
    if k not in dst:
        dst[k] = v
    elif isinstance(dst[k], dict) and isinstance(v, dict):
        for subk, subv in v.items():
            dst[k].setdefault(subk, subv)

with open(dst_path, "w", encoding="utf-8") as f:
    json.dump(dst, f, indent=2, ensure_ascii=False)
    f.write("\n")
print(f"[agy-box] Configured VSCodium settings: {dst_path}")
PY

	# Merge codium/keybindings.json into User/keybindings.json
	python3 - "$CODIUM_SRC_DIR/keybindings.json" "$CODIUM_USER_DIR/keybindings.json" <<'PY'
import json, os, sys

src_path, dst_path = sys.argv[1], sys.argv[2]
with open(src_path, encoding="utf-8") as f:
    src = json.load(f)

dst = []
if os.path.exists(dst_path):
    try:
        with open(dst_path, encoding="utf-8") as f:
            dst = json.load(f)
    except Exception:
        dst = []

existing_keys = {(item.get("key"), item.get("command")) for item in dst if isinstance(item, dict)}
for item in src:
    sig = (item.get("key"), item.get("command"))
    if sig not in existing_keys:
        dst.append(item)

with open(dst_path, "w", encoding="utf-8") as f:
    json.dump(dst, f, indent=2, ensure_ascii=False)
    f.write("\n")
print(f"[agy-box] Configured VSCodium keybindings: {dst_path}")
PY
}

cmd_install() {
	local with_codium=0
	for arg in "$@"; do
		[[ "$arg" == "--codium" ]] && with_codium=1
	done

	local bin_dir="$HOME/.local/bin"
	mkdir -p "$bin_dir"
	chmod +x "$BOX_DIR/agy-box"
	ln -sf "$BOX_DIR/agy-box" "$bin_dir/agy-box"
	info "Symlinked: $bin_dir/agy-box -> $BOX_DIR/agy-box"

	install_skills

	python3 - "$PROFILE_JSON" "$AGY_SETTINGS" "$LOCAL_GIT_SETTINGS" "$BOX_DIR/skills" "$GLOBAL_SKILLS_DIR" <<'PY'
import glob, json, os, sys

profile_path, runtime_path, git_path, box_skills_dir, global_skills_dir = sys.argv[1:6]
with open(profile_path, encoding="utf-8") as f:
    profile = json.load(f)

# Auto-allowlist bundled skill files (both canonical and ~/.gemini/config/skills paths)
skill_Dynamic_Allows = []
for root_dir in (box_skills_dir, global_skills_dir):
    if os.path.exists(root_dir):
        for dirpath, _, filenames in os.walk(root_dir, followlinks=True):
            for fn in filenames:
                if fn.endswith(".md"):
                    full = os.path.join(dirpath, fn)
                    skill_Dynamic_Allows.append(f"read_file({full})")

def merge_into(target_path):
    if os.path.exists(target_path):
        with open(target_path, encoding="utf-8") as f:
            data = json.load(f)
    else:
        os.makedirs(os.path.dirname(target_path), exist_ok=True)
        data = {}

    perms = data.setdefault("permissions", {})
    wildcard_only_in_sandbox = {"command(*)", "read_file(*)", "write_file(*)"}
    home = os.path.expanduser("~")
    for tier in ("deny", "ask", "allow"):
        existing = perms.get(tier, [])
        for entry in profile.get("permissions", {}).get(tier, []):
            if tier == "allow" and entry in wildcard_only_in_sandbox:
                continue
            if "{{ROOT}}" in entry:
                continue  # per-repo paths are rendered at launch time
            entry = entry.replace("{{HOME}}", home)
            if entry not in existing:
                existing.append(entry)
        if tier == "allow":
            for entry in skill_Dynamic_Allows:
                if entry not in existing:
                    existing.append(entry)
        perms[tier] = sorted(existing)

    text = json.dumps(data, indent=2, ensure_ascii=False)
    text = text.replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")
    tmp = f"{target_path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text + "\n")
    os.replace(tmp, target_path)

merge_into(runtime_path)
print(f"[agy-box] Updated: {runtime_path}")
if os.path.exists(os.path.dirname(git_path)):
    merge_into(git_path)
    print(f"[agy-box] Updated: {git_path}")
PY

	if (( with_codium )); then
		cmd_codium
	fi
}

cmd_status() {
	info "binary:  $(command -v agy || echo 'MISSING')"
	info "script:  $BOX_DIR/agy-box"
	info "profile: $PROFILE_JSON"
	info "codium:  $(command -v codium || echo 'NOT INSTALLED')"
	info "skills:  $(ls -1 "$GLOBAL_SKILLS_DIR" 2>/dev/null | tr '\n' ' ' || echo 'NONE')"

	if [[ -f "$AGY_SETTINGS" ]]; then
		python3 - "$AGY_SETTINGS" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    d = json.load(f)
p = d.get("permissions", {})
print(f"[agy-box] settings: {sys.argv[1]}")
print(f"  deny:  {len(p.get('deny', []))} rules")
print(f"  ask:   {len(p.get('ask', []))} rules")
print(f"  allow: {len(p.get('allow', []))} rules")
PY
	else
		err "Settings missing at $AGY_SETTINGS (run 'agy-box install')"
	fi
}

cmd_wp() {
	require_agy
	local site="${1:-$DEFAULT_SITE}"
	local port="${2:-$DEFAULT_PORT}"
	local wp_dir="$DEFAULT_WP_DIR"

	if [[ ! -d "$wp_dir" ]]; then
		err "Missing repo: $wp_dir (set WP_REPO_DIR to override)"
		exit 1
	fi

	cd "$wp_dir"
	info "repo:    $wp_dir"
	info "site:    $site"
	info "posts:   sites/$site/content/posts/"
	info "pages:   sites/$site/content/pages/"
	info "themes:  sites/$site/wp-content/themes/"

	if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
		if make dev site="$site" port="$port"; then
			info "preview: http://localhost:${port}"
			command -v open >/dev/null 2>&1 && open "http://localhost:${port}" >/dev/null 2>&1 || true
		else
			info "preview: failed to start container; continuing offline"
		fi
	else
		info "preview: docker not running (run 'make dev site=$site' once Docker is started)"
	fi

	local init_prompt=""
	if [[ -f "$WP_PROMPT_TPL" ]]; then
		init_prompt="$(sed -e "s/{{SITE}}/$site/g" -e "s/{{PORT}}/$port/g" "$WP_PROMPT_TPL")"
	fi

	local rendered
	rendered="$(render_profile "$wp_dir" "$wp_dir/sites/$site/wp-config.php")"

	if [[ -n "$init_prompt" ]]; then
		exec agy --sandbox --mode accept-edits --settings "$rendered" -i "$init_prompt

Output a 3-bullet status summary (site, paths, preview URL) and wait for instructions."
	else
		exec agy --sandbox --mode accept-edits --settings "$rendered"
	fi
}

cmd_default() {
	require_agy
	if [[ $# -gt 0 && -d "$1" ]]; then
		cd "$1"
		shift
	fi
	local git_root
	git_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
	cd "$git_root"
	info "workspace: $git_root"
	info "mode:      sandboxed (--sandbox --mode accept-edits)"
	exec agy --sandbox --mode accept-edits --settings "$(render_profile "$git_root")" "$@"
}

main() {
	local subcmd="${1:-}"
	case "$subcmd" in
		install)        shift; cmd_install "$@" ;;
		codium)         shift; cmd_codium "$@" ;;
		status)         shift; cmd_status "$@" ;;
		wp|wordpress)   shift; cmd_wp "$@" ;;
		help|-h|--help) usage ;;
		*)              cmd_default "$@" ;;
	esac
}

main "$@"
